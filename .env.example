# PostgreSQL development superuser.
# Only use this identity to bootstrap local databases.
POSTGRES_USER=tradeflow_dev

# Replace with your own local-only password in .env.
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Default development database for Phase 1 experiments.
POSTGRES_DB=tradeflow

# RabbitMQ local development user.
RABBITMQ_USER=tradeflow_dev

# Replace with a local-only password in .env.
RABBITMQ_PASSWORD=replace_with_local_rabbitmq_password
